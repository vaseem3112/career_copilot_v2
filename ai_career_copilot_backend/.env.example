CELERY_RESULT_BACKEND=redis://localhost:6379/1
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_CONTENT_LENGTH_MB=5
ALLOWED_EXTENSIONS=pdf,doc,docx
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6
